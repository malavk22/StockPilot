// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  stockMovements     StockMovement[]  @relation("MovementCreatedBy")
  purchaseOrdersMade PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  purchaseOrdersRecv PurchaseOrder[]  @relation("PurchaseOrderReceivedBy")
}

enum Role {
  ADMIN
  STAFF
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model Product {
  id                String   @id @default(uuid())
  sku               String   @unique
  name              String
  description       String?
  unit              String   @default("unit") // e.g. "unit", "kg", "box"
  price             Decimal  @default(0) @db.Decimal(10, 2) // unit price, for inventory value reporting
  lowStockThreshold Int      @default(0)
  supplierId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([sku])
}

// ─────────────────────────────────────────────────────────────
// Suppliers & Purchase Orders
//
// A purchase order is a draft until it's submitted, and its lines are
// only ever turned into ledger entries once — on receipt. Receiving posts
// one IN StockMovement per line (via the same recordMovement path as any
// other stock-in), so a received PO shows up in the ledger exactly like a
// manual restock would, just with the paper trail of what was ordered,
// from whom, and at what cost.
// ─────────────────────────────────────────────────────────────

model Supplier {
  id           String   @id @default(uuid())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  sequenceNumber Int                 @unique @default(autoincrement())
  supplierId     String
  warehouseId    String
  status         PurchaseOrderStatus @default(DRAFT)
  notes          String?
  createdById    String
  receivedById   String?
  createdAt      DateTime            @default(now())
  submittedAt    DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  warehouse  Warehouse           @relation(fields: [warehouseId], references: [id])
  createdBy  User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  receivedBy User?               @relation("PurchaseOrderReceivedBy", fields: [receivedById], references: [id])
  lines      PurchaseOrderLine[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Int
  unitCost        Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// Stock ledger
//
// Design decision: current stock is NEVER stored as a mutable counter.
// It is always derived by summing StockMovement.quantity (signed) for a
// given product (+ warehouse). This is an append-only audit log:
//   - IN          → positive quantity  (restock, purchase received)
//   - OUT         → negative quantity  (sale, usage, damage)
//   - ADJUSTMENT  → signed quantity    (manual correction, with a reason)
//   - TRANSFER_IN / TRANSFER_OUT → a warehouse-to-warehouse transfer is
//     recorded as two linked rows (one of each), created atomically so the
//     product's total stock is unaffected — only its location changes.
//
// Benefits over a mutable `quantity` column:
//   1. Correctness under concurrent writes — two simultaneous stock
//      deductions can't silently overwrite each other; both rows persist
//      and the sum is always accurate.
//   2. Full audit trail for free — "what happened to this product's stock
//      over time" is just a query, not a separate logging system.
//   3. Time-travel — stock level as of any past date is reconstructable.
// ─────────────────────────────────────────────────────────────

model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  warehouseId String
  type        MovementType
  quantity    Int          // signed: positive = stock in, negative = stock out
  reason      String?
  createdById String
  createdAt   DateTime     @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy   User      @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([createdAt])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

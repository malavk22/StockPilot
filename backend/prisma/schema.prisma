// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  stockMovements StockMovement[] @relation("MovementCreatedBy")
}

enum Role {
  ADMIN
  STAFF
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stockMovements StockMovement[]

  @@index([name])
}

model Product {
  id                String   @id @default(uuid())
  sku               String   @unique
  name              String
  description       String?
  unit              String   @default("unit") // e.g. "unit", "kg", "box"
  lowStockThreshold Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  stockMovements StockMovement[]

  @@index([sku])
}

// ─────────────────────────────────────────────────────────────
// Stock ledger
//
// Design decision: current stock is NEVER stored as a mutable counter.
// It is always derived by summing StockMovement.quantity (signed) for a
// given product (+ warehouse). This is an append-only audit log:
//   - IN          → positive quantity  (restock, purchase received)
//   - OUT         → negative quantity  (sale, usage, damage)
//   - ADJUSTMENT  → signed quantity    (manual correction, with a reason)
//   - TRANSFER_IN / TRANSFER_OUT → a warehouse-to-warehouse transfer is
//     recorded as two linked rows (one of each), created atomically so the
//     product's total stock is unaffected — only its location changes.
//
// Benefits over a mutable `quantity` column:
//   1. Correctness under concurrent writes — two simultaneous stock
//      deductions can't silently overwrite each other; both rows persist
//      and the sum is always accurate.
//   2. Full audit trail for free — "what happened to this product's stock
//      over time" is just a query, not a separate logging system.
//   3. Time-travel — stock level as of any past date is reconstructable.
// ─────────────────────────────────────────────────────────────

model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  warehouseId String
  type        MovementType
  quantity    Int          // signed: positive = stock in, negative = stock out
  reason      String?
  createdById String
  createdAt   DateTime     @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy   User      @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([createdAt])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}
